# MI300X host used for the 2026-11 verification (results/mi300-2026-11). Copy the lines you need into deploy/.env.
# HIP id -> BDF -> renderD (verified with `torch.cuda.get_device_properties(i).pci_bus_id` + /sys/bus/pci/devices/<bdf>/drm):
#   HIP0 76:00.0 renderD128 | HIP1 06:00.0 renderD136 | HIP2 66:00.0 renderD144 | HIP3 16:00.0 renderD152
#   HIP4 f6:00.0 renderD160 (production on that host: deliberately NOT in the map) | HIP5 86:00.0 renderD168
#   HIP6 e6:00.0 renderD176 | HIP7 96:00.0 renderD184
# RENDER_MAP only affects tools/experiments/exp.sh; compose.yaml still mounts /dev/dri whole. REPLICA_*_HIP also change compose.yaml.
# The mapping is host-specific; rebuild it on another machine before use.
RENDER_MAP="0=128 1=136 2=144 3=152 5=168 6=176 7=184"
REPLICA_A_HIP=6,7        # Pair A
REPLICA_B_HIP=2,3        # Pair B
