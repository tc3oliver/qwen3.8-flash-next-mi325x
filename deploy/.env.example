# Copy to deploy/.env (chmod 600). .env holds secrets and is git-ignored.
# Images pinned by digest (tags move). vLLM v0.32.0 ROCm 7.2.3 / LiteLLM v1.105.1.
VLLM_IMAGE=vllm/vllm-openai-rocm@sha256:14f6a575e1fb0a580b0f633c09e06f648709d60405b85f6a7ff3f80d49f39905
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:b7b9e2c306343721802253d0dd9436b9634a2eb4e14da7c7cf06c5c7b7530802

MODEL_DIR=/path/to/models/qwen3.8-flash-next-fp8   # weights, mounted read-only
SERVED_MODEL_NAME=qwen3.8-flash-next

# Layout (compose profile): tp2x2 = two TP2 replicas (18.7M KV tokens total; used for ~100 users),
# tp1x4 = four single-GPU replicas (1.4-1.7x faster per GPU, 7.4M KV tokens). See README.
LAYOUT=tp2x2

# GPU mapping (amd-smi GPU -> HIP id, verified via KFD node order and in-container check):
#   GPU0 07:00.0 -> HIP1 | GPU1 17:00.0 -> HIP3 | GPU2 67:00.0 -> HIP2 | GPU3 77:00.0 -> HIP0
# All pairs are direct XGMI (weight 15), all on NUMA 0.
# tp1x4
R1_HIP=1
R2_HIP=3
R3_HIP=2
R4_HIP=0
R1_PORT=8001
R2_PORT=8002
R3_PORT=8003
R4_PORT=8004
# tp2x2
REPLICA_A_HIP=1,3
REPLICA_B_HIP=2,0
REPLICA_A_PORT=8001
REPLICA_B_PORT=8002
TP2_QUICK_REDUCE=INT6        # TP2 all-reduce quantization (NONE | FP | INT8 | INT6 | INT4)
BIND_ADDR=127.0.0.1          # vLLM has no auth: keep replicas local, expose only LiteLLM

MAX_MODEL_LEN=262144
MAX_NUM_SEQS=64
GPU_MEMORY_UTILIZATION=0.93
MAX_NUM_BATCHED_TOKENS=32768
VLLM_ROCM_USE_AITER_MOE=1
MTP_TOKENS=3

LITELLM_BIND_ADDR=0.0.0.0
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-me
